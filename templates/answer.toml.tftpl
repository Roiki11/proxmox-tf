# Proxmox VE automated installation answer file.
# Generated by OpenTofu (proxmox-tf) - do not edit manually.
# Schema reference: https://pve.proxmox.com/wiki/Automated_Installation

[global]
keyboard = "${keyboard}"
country = "${country}"
fqdn = "${fqdn}"
timezone = "${timezone}"
%{ if mailto != "" }
mailto = "${mailto}"
%{ endif }
%{ if root_password_hashed != "" }
root-password-hashed = "${root_password_hashed}"
%{ else }
root-password = "${root_password}"
%{ endif }
%{ if length(root_ssh_keys) > 0 }
root-ssh-keys = [
%{ for key in root_ssh_keys }
  "${key}",
%{ endfor }
]
%{ endif }
%{ if subscription_key != "" }
subscription-key = "${subscription_key}"
%{ endif }
reboot-on-error = ${reboot_on_error ? "true" : "false"}
reboot-mode = "reboot"

[network]
%{ if network_dhcp }
source = "from-dhcp"
%{ else }
source = "from-answer"
cidr = "${network_cidr}"
%{ if network_gateway != "" }
gateway = "${network_gateway}"
%{ endif }
%{ if network_dns != "" }
dns = "${network_dns}"
%{ endif }
%{ if length(network_filter) > 0 }
%{ for prop, value in network_filter }
filter.${prop} = "${value}"
%{ endfor }
%{ endif }
%{ endif }

[disk-setup]
filesystem = "${filesystem}"
%{ if length(disk_filter) > 0 }
# udev property filters select the disks (mutually exclusive with disk-list).
filter-match = "${filter_match}"
%{ for prop, value in disk_filter }
filter.${prop} = "${value}"
%{ endfor }
%{ else }
disk-list = [
%{ for disk in disk_list }
  "${disk}",
%{ endfor }
]
%{ endif }
%{ if zfs_raid != "" }
zfs.raid = "${zfs_raid}"
%{ if zfs_ashift > 0 }
zfs.ashift = ${zfs_ashift}
%{ endif }
%{ if zfs_arc_max > 0 }
zfs.arc-max = ${zfs_arc_max}
%{ endif }
%{ endif }
%{ if lvm_hdsize > 0 }
lvm.hdsize = ${lvm_hdsize}
%{ endif }
%{ if lvm_swapsize > 0 }
lvm.swapsize = ${lvm_swapsize}
%{ endif }

%{ if first_boot_enabled }
[first-boot]
source = "from-iso"
ordering = "${first_boot_ordering}"
%{ endif }
%{ if webhook_url != "" }
[post-installation-webhook]
url = "${webhook_url}"
%{ if webhook_cert_fingerprint != "" }
cert-fingerprint = "${webhook_cert_fingerprint}"
%{ endif }
%{ if webhook_auth_token != "" }
auth-token = "${webhook_auth_token}"
%{ endif }
%{ endif }
