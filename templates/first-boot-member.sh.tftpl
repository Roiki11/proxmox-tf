#!/usr/bin/env bash
# Generated by OpenTofu (proxmox-tf) - do not edit manually.
# First-boot hook for a member node: joins the PVE cluster non-interactively.
#
# Equivalent to `pvecm add BOOTSTRAP` (API join, no --use_ssh): it authenticates
# to the local PVE API with the local root password and issues
# POST /cluster/config/nodes {hostname, password, fingerprint, link0} —
# the same join endpoint the web UI "Join Cluster" dialog uses.
set -uo pipefail

LOG=/var/log/pve-first-boot.log
exec >>"$LOG" 2>&1

BOOTSTRAP_NODE=${bootstrap_address}
BOOTSTRAP_ROOT_PASSWORD=${bootstrap_root_password}
LOCAL_ROOT_PASSWORD=${local_root_password}
MY_IP=${my_ip}

if [ -f /etc/pve/corosync.conf ]; then
    echo "$(date --iso-8601=seconds) [first-boot] corosync config already present, nothing to do"
    exit 0
fi

fetch_fingerprint() {
    openssl s_client -connect "$BOOTSTRAP_NODE:8006" </dev/null 2>/dev/null \
        | openssl x509 -fingerprint -sha256 -noout | cut -d= -f2
}

get_ticket() {
    curl -sk --max-time 20 -X POST 'https://localhost:8006/api2/json/access/ticket' \
        --data-urlencode 'username=root@pam' \
        --data-urlencode "password=$LOCAL_ROOT_PASSWORD"
}

for attempt in $(seq 1 60); do
    echo "$(date --iso-8601=seconds) [first-boot] attempt $attempt: waiting for bootstrap node $BOOTSTRAP_NODE"

    if ! curl -sk --max-time 10 -o /dev/null "https://$BOOTSTRAP_NODE:8006/"; then
        echo "$(date --iso-8601=seconds) [first-boot] bootstrap node API not reachable yet"
        sleep 15
        continue
    fi

    FP=$(fetch_fingerprint)
    if [ -z "$FP" ]; then
        echo "$(date --iso-8601=seconds) [first-boot] could not read peer certificate fingerprint"
        sleep 15
        continue
    fi

    TICKET_JSON=$(get_ticket || true)
    TICKET=$(printf '%s' "$TICKET_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["data"]["ticket"])' 2>/dev/null || true)
    CSRF=$(printf '%s' "$TICKET_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["data"]["CSRFPreventionToken"])' 2>/dev/null || true)
    if [ -z "$TICKET" ]; then
        echo "$(date --iso-8601=seconds) [first-boot] could not authenticate against local API"
        sleep 15
        continue
    fi

    BODY=$(python3 -c 'import json,sys
print(json.dumps({
    "hostname": sys.argv[1],
    "password": sys.argv[2],
    "fingerprint": sys.argv[3],
    "link0": sys.argv[4],
}))' "$BOOTSTRAP_NODE" "$BOOTSTRAP_ROOT_PASSWORD" "$FP" "$MY_IP")

    HTTP_CODE=$(curl -sk --max-time 60 -o /tmp/pve-join-response.json -w '%%{http_code}' \
        -X POST 'https://localhost:8006/api2/json/cluster/config/nodes' \
        -H 'Content-Type: application/json' \
        -b "PVEAuthCookie=$TICKET" \
        -H "CSRFPreventionToken: $CSRF" \
        -d "$BODY")

    if [ "$HTTP_CODE" = "200" ]; then
        echo "$(date --iso-8601=seconds) [first-boot] join request accepted, waiting for corosync to become quorate"
        for wait in $(seq 1 60); do
            if pvecm status >/dev/null 2>&1; then
                echo "$(date --iso-8601=seconds) [first-boot] node '$(hostname)' successfully joined cluster"
                exit 0
            fi
            sleep 10
        done
        echo "$(date --iso-8601=seconds) [first-boot] WARNING: join accepted but corosync not quorate within timeout"
        exit 0
    fi

    echo "$(date --iso-8601=seconds) [first-boot] join request returned HTTP $HTTP_CODE: $(cat /tmp/pve-join-response.json 2>/dev/null || true)"
    sleep 20
done

echo "$(date --iso-8601=seconds) [first-boot] ERROR: failed to join cluster after 60 attempts"
exit 1
