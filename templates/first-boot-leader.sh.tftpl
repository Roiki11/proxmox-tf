#!/usr/bin/env bash
# Generated by OpenTofu (proxmox-tf) - do not edit manually.
# First-boot hook for the bootstrap (leader) node: creates a new PVE cluster.
set -uo pipefail

LOG=/var/log/pve-first-boot.log
exec >>"$LOG" 2>&1

echo "$(date --iso-8601=seconds) [first-boot] bootstrap node starting"

CLUSTER_NAME=${cluster_name}
LINK0=${link0}

if [ -f /etc/pve/corosync.conf ] && pvecm status >/dev/null 2>&1; then
    echo "$(date --iso-8601=seconds) [first-boot] cluster already exists, nothing to do"
    exit 0
fi

for attempt in $(seq 1 20); do
    echo "$(date --iso-8601=seconds) [first-boot] attempt $attempt: pvecm create $CLUSTER_NAME --link0 $LINK0"
    if pvecm create "$CLUSTER_NAME" --link0 "$LINK0"; then
        echo "$(date --iso-8601=seconds) [first-boot] cluster '$CLUSTER_NAME' created"
        exit 0
    fi
    sleep 15
done

echo "$(date --iso-8601=seconds) [first-boot] ERROR: failed to create cluster after 20 attempts"
exit 1
