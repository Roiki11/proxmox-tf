# Example configuration for the proxmox-tf project.
# Copy to terraform.tfvars (gitignored) and adapt.
#
# SECRETS: no secrets belong in this file. All credentials are read from a
# HashiCorp Vault KV-v2 secret (see vault.tf for the expected fields). The
# Vault provider authenticates via the VAULT_ADDR / VAULT_TOKEN environment
# variables (or add an auth_login_* block in providers.tf).

cluster_name   = "lab"
cluster_domain = "example.lan"
bootstrap_node = "node01"

root_ssh_keys = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... you@host",
]

keyboard = "en-us"
country  = "us"
mailto   = "admin@example.lan"

# Base PVE ISO: downloaded automatically on first `make isos` if missing.
pve_iso_url      = "https://download.proxmox.com/iso/proxmox-ve_9.2-1.iso"
pve_iso_checksum = "" # optional; changing it rebuilds all ISOs

# Base URL serving build/iso over HTTP for Redfish virtual media boot
# (start with `make iso-serve`; must be reachable from the BMCs).
iso_http_base_url = "http://10.0.0.1:8080"

# Machine installation via the dell/redfish provider (redfish.tf): attaches
# the ISO as virtual media, arms a one-time boot and resets/powers the
# machine — only for nodes whose PVE API does not answer yet.
node_install_enabled       = true
node_install_reset_type    = "PowerCycle" # powers on machines that are off
node_install_power_on      = true
redfish_ssl_insecure       = true

nodes = {
  node01 = {
    # Bootstrap node: creates the cluster on first boot.
    management_cidr = "10.0.0.11/24"
    gateway         = "10.0.0.1"
    dns_server      = "10.0.0.1"
    filesystem      = "zfs"
    zfs_raid        = "raid1"
    disks           = ["sda", "sdb"]
    zfs_ashift      = 12
    nic_filter      = { "ID_NET_NAME" = "eno1" }
    # BMC for Redfish boot tasks (password from Vault field
    # 'bmc_node01_password'; install with `make node-install REDFISH_NODE=node01`).
    bmc = {
      address = "https://10.0.0.201"
    }
  }
  node02 = {
    management_cidr = "10.0.0.12/24"
    filesystem      = "zfs"
    zfs_raid        = "raid1"
    disks           = ["sda", "sdb"]
    bmc = {
      address  = "https://10.0.0.202"
      username = "root"
    }
  }
  node03 = {
    management_cidr = "10.0.0.13/24"
    filesystem      = "zfs"
    zfs_raid        = "raid1"
    disks           = ["sda", "sdb"]
    bmc = {
      address     = "https://10.0.0.203"
      # Vendor-specific one-time boot source override target, if "Cd" is wrong:
      boot_target = "Cd"
    }
  }
}

# Optional: notify an HTTP endpoint after each installation finishes.
# Its bearer token comes from the Vault field post_installation_webhook_token.
# post_installation_webhook = {
#   url = "https://pdm.example.com/api/install-callback"
# }

# Container running proxmox-auto-install-assistant (proxmox_auto_install_assistant_container).
container_engine             = "docker"
container_platform           = "" # "linux/amd64" on Apple Silicon
auto_install_assistant_image = "proxmox-auto-install-assistant:latest"

###############################################################################
# Phase 2 (after nodes are installed and clustered):
###############################################################################

pve_endpoint = "https://10.0.0.11:8006/"
manage_pve_resources = true

cluster_options = {
  keyboard       = "en-us"
  email_from     = "proxmox@example.lan"
  migration_type = "secure"
  next_id_lower  = 100
  next_id_upper  = 999999
}

# Issue per-node TLS certificates from Vault PKI and install them on the nodes.
node_tls_enabled    = true
vault_pki_backend   = "pki_int"
vault_pki_role      = "proxmox-node"
vault_pki_ttl       = "8760h"

###############################################################################
# Direct cluster configuration (phase 2): storage, network, SDN and Ceph,
# managed via the bpg/proxmox provider. Apply selectively:
#   make pve-storage | pve-network | pve-sdn | pve-ceph
###############################################################################

# Storage definitions (keyed by storage ID).
storage_directories = {
  "iso-store" = {
    path     = "/tank/iso"
    content  = ["iso"]
    nodes    = ["node01", "node02", "node03"]
    shared   = true
    create_base_path = true
    create_subdirs   = true
    backups = {
      keep_daily = 7
      max_protected_backups = 5
    }
  }
}
storage_zfspool = {
  "fast-pool" = {
    zfs_pool       = "rpool/fast"
    content        = ["images", "rootdir"]
    nodes          = ["node01", "node02", "node03"]
    thin_provision = true
  }
}
# storage_lvm = { ... volume_group, thin_pool (lvmthin) ... }
# storage_nfs = { ... server, export ... }
# storage_cifs = { ... server, share, username ... SMB password from Vault
#                  field 'storage_<id>_password' }
# storage_pbs = { ... server, datastore, username, fingerprint ... PBS
#                 password from Vault field 'storage_<id>_password' }

# Node network interfaces (staged, then activated by the per-node applier).
network_bridges = {
  "node01-vmbr1" = {
    node_name = "node01"
    name      = "vmbr1"
    ports     = ["eno1"]
    vlan_aware = true
    vids      = "2-4094"
    comment   = "guest bridge"
  }
}
# network_bonds = { ... slaves, bond_mode ... }
# network_vlans = { ... name 'eno1.99' or custom name + interface + vlan ... }

# SDN: zones -> VNets -> subnets; changes are applied by the SDN applier.
sdn_zones = {
  "vlan1" = {
    type   = "vlan"
    bridge = "vmbr0"
    ipam   = "pve"
  }
}
sdn_vnets = {
  "vnet10" = {
    zone = "vlan1"
    tag  = 10
  }
}
sdn_subnets = {
  "vnet10-subnet" = {
    vnet     = "vnet10"
    cidr     = "10.10.10.0/24"
    gateway  = "10.10.10.1"
    snat     = true
  }
}
# sdn_zones type 'vxlan' takes peers = node IPs; 'evpn' takes controller +
# vrf_vxlan. Requires an existing bridge for vlan zones.

# Ceph pools (declare after Ceph is initialized on the cluster; pools only —
# monitors/OSDs are not managed by the provider).
# ceph_pools = {
#   "tank" = {
#     size     = 3
#     min_size = 2
#     pg_num   = 128
#     application = "rbd"
#     add_storages = true
#   }
# }

###############################################################################
# Phase 3: manage the cluster as a remote in Proxmox Datacenter Manager
# through its REST API.
###############################################################################

pdm_enabled  = true
pdm_api_url  = "https://10.0.0.2:8007" # PDM REST API base URL
pdm_web_url  = "https://10.0.0.2:8007"
pdm_verify_nodes = true

# Node configuration applied through the PDM REST API (see variables-pdm.tf).
# Writable through PDM: APT database updates and node firewall options.
pdm_node_config = {
  node01 = {
    apt_update = true
    firewall_options = {
      enable           = true
      log_level_in     = "info"
      nftables         = false
      protection_synflood = true
    }
  }
  node02 = {
    apt_update = true
  }
}

# One-off inspection/management tasks (connection via PDM_* env vars):
#   make pdm-node-status PDM_NODE=node01
#   make pdm-node-network PDM_NODE=node01
#   make pdm-node-updates PDM_NODE=node01
#   make pdm-node-apply PDM_NODE=node01
#   make pdm-updates-refresh
